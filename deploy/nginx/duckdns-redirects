# The old DuckDNS hosts -> the new ones. Copy to /etc/nginx/sites-available/duckdns-redirects. These blocks
# REPLACE the old chef-lan-web / chef-lan-admin site files for those hosts: in the same step remove those two
# links from sites-enabled and link this file, then nginx -t and reload (otherwise nginx warns about a
# conflicting server_name and keeps serving the old block).
# $request_uri keeps path and query; a #fragment (invite links) is kept by the browser across a 301.

# --- course-cheflan.duckdns.org -> courses.bonbocon.com ----------------------------------------
server {
    listen 80;
    listen [::]:80;
    server_name course-cheflan.duckdns.org;

    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name course-cheflan.duckdns.org;

    ssl_certificate /etc/letsencrypt/live/course-cheflan.duckdns.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/course-cheflan.duckdns.org/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    # TEMPORARY: SePay's IPN URL still points at this host. Keep proxying /api/ until it is changed to
    # https://api.bonbocon.com/api/v1/payments/sepay/ipn, then delete this block (uploads already
    # go through api.bonbocon.com).
    location /api/ {
        proxy_pass http://127.0.0.1:5100;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # OVERWRITE, never append: the API's login rate limit trusts this header.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 6m;
    }

    location / {
        return 301 https://courses.bonbocon.com$request_uri;
    }
}

