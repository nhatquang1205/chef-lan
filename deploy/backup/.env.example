# Copy to .env next to backup-db.sh (mode 600). Placeholders only: the real values live on the VPS and in the password manager.

# Same webhook as Dozzle (deploy/monitoring). A credential.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/<id>/<token>

# Encrypts every dump (gpg, AES256). Generate with: openssl rand -base64 32
# Store it in the password manager FIRST: without it the backups cannot be read.
BACKUP_PASSPHRASE=<generated passphrase>

# Backblaze B2: a private bucket just for backups, and an application key restricted to that bucket.
B2_KEY_ID=<application key id>
B2_APP_KEY=<application key>
B2_BUCKET=<bucket name>

# Optional (defaults shown)
#PG_CONTAINER=postgres
#DB_NAME=cheflan
#RCLONE_IMAGE=rclone/rclone:1.68.2
#LOG_FILE=/home/nina/chef-lan-backup/backup.log
# Tests only: an rclone destination instead of B2, e.g. an absolute local folder.
#BACKUP_TARGET=
