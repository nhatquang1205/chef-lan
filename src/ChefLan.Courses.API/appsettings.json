{
  "ConnectionStrings": {
    "ChefLanDb": ""
  },
  "Jwt": {
    "Internal": {
      "Issuer": "cheflan",
      "Audience": "cheflan-internal",
      "AccessTokenMinutes": 15,
      "RefreshTokenDays": 1
    },
    "Customer": {
      "Issuer": "cheflan",
      "Audience": "cheflan-customer",
      "AccessTokenMinutes": 15,
      "RefreshTokenDays": 30
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ]
  },
  "AllowedHosts": "*"
}
