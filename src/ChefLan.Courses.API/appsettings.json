{
  "ConnectionStrings": {
    "ChefLanDb": ""
  },
  "Jwt": {
    "Internal": {
      "Issuer": "cheflan",
      "Audience": "cheflan-internal",
      "AccessTokenMinutes": 15,
      "RefreshTokenDays": 1
    },
    "Customer": {
      "Issuer": "cheflan",
      "Audience": "cheflan-customer",
      "AccessTokenMinutes": 15,
      "RefreshTokenDays": 30
    }
  },
  "RateLimiting": {
    "auth-login": { "PermitLimit": 5, "WindowSeconds": 60 },
    "auth-register": { "PermitLimit": 3, "WindowSeconds": 60 },
    "auth-refresh": { "PermitLimit": 20, "WindowSeconds": 60 }
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "ForwardedHeaders": {
    "KnownProxies": []
  },
  "Storage": {
    "B2": {
      "Bucket": "",
      "Endpoint": "",
      "Region": "",
      "PublicBaseUrl": ""
    }
  },
  "Payment": {
    "CodePrefix": "BB",
    "OrderLifetimeMinutes": 1440,
    "ContactOrderLifetimeDays": 7,
    "SePay": {
      "CheckoutUrl": "https://pay.sepay.vn/v1/checkout/init"
    }
  },
  "Video": {
    "Bunny": {
      "LibraryId": "",
      "EmbedBaseUrl": "https://iframe.mediadelivery.net",
      "TokenLifetimeSeconds": 7200
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ]
  },
  "AllowedHosts": "*",
  "Web": {
    "PublicBaseUrl": ""
  }
}
