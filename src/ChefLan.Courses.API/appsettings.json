{
  "ConnectionStrings": {
    "ChefLanDb": ""
  },
  "Jwt": {
    "Internal": {
      "Issuer": "cheflan",
      "Audience": "cheflan-internal",
      "AccessTokenMinutes": 15,
      "RefreshTokenDays": 1
    },
    "Customer": {
      "Issuer": "cheflan",
      "Audience": "cheflan-customer",
      "AccessTokenMinutes": 15,
      "RefreshTokenDays": 30
    }
  },
  "RateLimiting": {
    "auth-login": { "PermitLimit": 5, "WindowSeconds": 60 },
    "auth-register": { "PermitLimit": 3, "WindowSeconds": 60 },
    "auth-refresh": { "PermitLimit": 20, "WindowSeconds": 60 }
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "ForwardedHeaders": {
    "KnownProxies": []
  },
  "Storage": {
    "Bunny": {
      "StorageZone": "",
      "Endpoint": "https://storage.bunnycdn.com",
      "CdnBaseUrl": ""
    }
  },
  "Video": {
    "Bunny": {
      "LibraryId": "",
      "EmbedBaseUrl": "https://iframe.mediadelivery.net",
      "TokenLifetimeSeconds": 7200
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ]
  },
  "AllowedHosts": "*"
}
